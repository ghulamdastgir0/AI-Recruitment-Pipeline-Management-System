generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
  moduleFormat    = "cjs"
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// ─── Identity ───────────────────────────────────────────────
// Three staff roles (see Role enum): SUPER_ADMIN runs the company/users/RAG
// docs, HR_ADMIN runs day-to-day recruiting through the assistant,
// HIRING_MANAGER is read+comment-only, scoped to assigned job postings via
// JobPostingHiringManager. RECRUITER/INTERVIEWER/CANDIDATE are gone —
// interviewing is fully automated (see AIInterviewSession) and no
// self-service candidate portal/login has ever been built.

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  role         Role
  // Deactivate/"remove" toggle — enforced on every authenticated request
  // (JwtAuthGuard), not just at login, so revoking access doesn't wait out
  // the JWT's expiry window.
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  candidateProfile        CandidateProfile?
  jobsCreated              Job[]                     @relation("JobCreatedBy")
  emailsTriggered          EmailLog[]                @relation("EmailTriggeredBy")
  documentsUploaded        Document[]                @relation("DocumentUploadedBy")
  auditLogs                AuditLog[]
  actionsRequested         PendingAssistantAction[]  @relation("PendingActionRequestedBy")
  actionsConfirmed         PendingAssistantAction[]  @relation("PendingActionConfirmedBy")
  hiringManagerAssignments JobPostingHiringManager[] @relation("HiringManagerAssignments")
  assignmentsGiven         JobPostingHiringManager[] @relation("HiringManagerAssignedBy")
  candidateComments        CandidateComment[]
}

model CandidateProfile {
  id     String          @id @default(uuid())
  // Optional: HR-sourced CVs (uploaded by HR via the recruitment assistant,
  // scored for a job posting) have no portal login and therefore no User.
  // Only candidates who registered themselves have a userId.
  userId String?         @unique
  // Where this profile came from — HR_SOURCED profiles are created purely
  // for AI-assisted screening and never had the candidate register/apply.
  source CandidateSource @default(SELF_APPLIED)

  resumeUrl         String
  resumeText        String? @db.Text
  // SHA-256 of the uploaded CV bytes — lets a CV re-uploaded against a
  // different job posting reuse the already-parsed profile instead of
  // reprocessing it.
  resumeContentHash String?
  resumeFilePath    String?
  // Per-page extracted text ([{ pageNumber, text }]), kept so match evidence
  // can cite a page number the same way document chatbot citations do.
  resumePagesJson   Json?

  // Raw LLM Schema Extractor output (FR-RES-01): name/email/skills/experience
  // as parsed from the uploaded document, kept for audit independent of the
  // user-entered profile fields above.
  extractedDataJson Json?
  educationJson     Json?
  experienceYears   Int?
  resumeEmbedding   Unsupported("vector(384)")?

  cvStatus          CvProcessingStatus @default(READY)
  cvProcessingError String?            @db.Text

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  user            User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  candidateSkills CandidateSkill[]
  applications    Application[]
  comments        CandidateComment[]

  @@index([resumeContentHash])
}

model CandidateSkill {
  candidateProfileId String
  skillId            String

  candidateProfile CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  skill            Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([candidateProfileId, skillId])
}

model Skill {
  id   String @id @default(uuid())
  name String @unique

  candidateSkills      CandidateSkill[]
  jobSkills            JobSkill[]
  candidateSkillGrades CandidateSkillGrade[]
  interviewQuestions   AIInterviewQuestion[]
}

// ─── HR Policy Document RAG (chatbot) ────────────────────────
// Admin-uploaded company policy PDFs. Each upload is stored permanently and
// processed exactly once into embedded chunks; re-uploading the same
// document creates a new version rather than mutating the old one, so the
// chatbot always retrieves from a single ACTIVE version while every prior
// version is preserved for audit history.

model Document {
  id               String         @id @default(uuid())
  name             String
  originalFileName String
  filePath         String
  // SHA-256 of the uploaded file bytes — lets the upload endpoint detect an
  // identical re-upload of the same version and skip reprocessing it.
  contentHash      String
  version          Int
  status           DocumentStatus @default(PROCESSING)
  // Populated only if background extraction/embedding fails, so a bad PDF
  // is visible to an admin instead of silently stuck in PROCESSING.
  processingError  String?        @db.Text
  uploadedByUserId String?
  uploadedAt       DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  uploadedBy User?           @relation("DocumentUploadedBy", fields: [uploadedByUserId], references: [id])
  chunks     DocumentChunk[]

  @@unique([name, version])
  @@index([name, status])
  @@index([status])
}

model DocumentChunk {
  id         String                      @id @default(uuid())
  documentId String
  content    String                      @db.Text
  embedding  Unsupported("vector(384)")?
  pageNumber Int
  chunkIndex Int
  createdAt  DateTime                    @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([documentId])
}

// ─── Jobs / Config ──────────────────────────────────────────

model Job {
  id    String @id @default(uuid())
  title String

  // FR-JOB-01/02: the HR one-line prompt, the raw RAG/LLM output, and the
  // final (possibly HR-edited) description that actually gets published.
  rawPrompt            String                      @db.Text
  generatedDescription String                      @db.Text
  description          String                      @db.Text
  embedding            Unsupported("vector(384)")?

  experienceMin Int
  salaryMax     Int?
  deadline      DateTime
  status        JobStatus @default(DRAFT)

  location  String?
  seniority String?
  workModel WorkModel?

  // FR-HR-03: hiring quota / "Hired" cap driving autonomic closure.
  hiringTarget        Int
  hiredCount          Int       @default(0)
  portalPublishedAt   DateTime?
  portalUnpublishedAt DateTime?

  createdByUserId String
  createdAt       DateTime @default(now())

  createdBy      User                      @relation("JobCreatedBy", fields: [createdByUserId], references: [id])
  jobSkills      JobSkill[]
  applications   Application[]
  linkedInPost   LinkedInPost?
  hiringManagers JobPostingHiringManager[]
  comments       CandidateComment[]

  @@index([status])
}

model JobSkill {
  jobId    String
  skillId  String
  required Boolean @default(true)

  job   Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([jobId, skillId])
}

// FR-JOB-03 & FR-HR-03: LinkedIn Share/Publish API tracking, including the
// tracking URL embedded in the post and its removal once the job closes.

model LinkedInPost {
  id             String    @id @default(uuid())
  jobId          String    @unique
  linkedInPostId String    @unique
  postUrl        String
  trackingUrl    String
  postedAt       DateTime  @default(now())
  removedAt      DateTime?

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

// Hiring Managers only see/comment on job postings they've been explicitly
// assigned to (RBAC requirement 6) — enforced by JobAssignmentGuard, backed
// by this table rather than any tenant/company concept (single-company
// deployment).

model JobPostingHiringManager {
  id                  String   @id @default(uuid())
  jobId               String
  hiringManagerUserId String
  assignedByUserId    String
  assignedAt          DateTime @default(now())

  job           Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  hiringManager User @relation("HiringManagerAssignments", fields: [hiringManagerUserId], references: [id], onDelete: Cascade)
  assignedBy    User @relation("HiringManagerAssignedBy", fields: [assignedByUserId], references: [id])

  @@unique([jobId, hiringManagerUserId])
  @@index([hiringManagerUserId])
}

// Hiring Manager feedback on a candidate, scoped to one job posting (a
// candidate can be evaluated — and commented on — separately per posting,
// same scoping as Application/MatchResult). Groundwork for the future
// interview module, not implemented yet.

model CandidateComment {
  id            String   @id @default(uuid())
  candidateId   String
  jobPostingId  String
  authorUserId  String
  content       String   @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  candidate  CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobPosting Job              @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  author     User             @relation(fields: [authorUserId], references: [id])

  @@index([candidateId, jobPostingId])
  @@index([jobPostingId])
}

// ─── Pipelines ──────────────────────────────────────────────

model Application {
  id                 String    @id @default(uuid())
  candidateProfileId String
  jobId              String
  status             AppStatus @default(APPLIED)

  // FR-RES-02: hard-gate semantic match score (>=80 advances). Nullable
  // because an Application can now exist before any match has been run
  // (created at CV-upload time by the recruitment assistant).
  skillMatchPct Decimal?  @db.Decimal(5, 2)
  screenedAt    DateTime?

  // FR-INT-01: 48-hour window to complete the automated interview, opened
  // the moment the candidate clears the hard gate.
  interviewWindowOpensAt   DateTime?
  interviewWindowExpiresAt DateTime?

  // Overall composite score (match % + interview performance) shown on the
  // HR scoreboard (FR-HR-01).
  compositeScore Decimal? @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidateProfile CandidateProfile    @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  job              Job                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  interviewSession AIInterviewSession?
  emailLogs        EmailLog[]
  matchResults     MatchResult[]

  @@unique([candidateProfileId, jobId])
  @@index([jobId, status])
}

// ─── AI Recruitment Assistant (ATS-style matching + tool-calling) ─────
// A MatchResult is one explainable match run (score + evidence) against a
// single Application. Never overwritten — re-running matchCandidateToJob
// appends a new row, "latest" = most recent processedAt, so score history
// stays auditable the same way Document versions do.

model MatchResult {
  id            String @id @default(uuid())
  applicationId String

  overallScore   Decimal             @db.Decimal(5, 2)
  recommendation MatchRecommendation
  confidence     MatchConfidence
  summary        String              @db.Text

  matchedSkillsJson         Json
  missingRequiredSkillsJson Json
  // [{ criterion, result: MATCHED|PARTIAL|MISSING, source }]
  evidenceJson              Json
  // per-category weighted subscores, e.g. { requiredSkills, preferredSkills,
  // relevantExperience, projects, education }
  breakdownJson             Json

  modelVersion String
  processedAt  DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, processedAt])
}

// Generic audit trail: one row per tool execution / confirmed / cancelled
// assistant action, so every mutation the assistant makes is attributable
// to a real HR user.

model AuditLog {
  id           String   @id @default(uuid())
  actorUserId  String
  action       String
  resourceType String
  resourceId   String?
  detailsJson  Json?
  createdAt    DateTime @default(now())

  actor User @relation(fields: [actorUserId], references: [id])

  @@index([actorUserId, createdAt])
  @@index([resourceType, resourceId])
}

// A tool the assistant wants to run but that requirement 7 says must not
// fire without explicit HR confirmation (publishing a job, changing a job's
// status). The orchestrator never executes these itself — it stores the
// request here and returns a preview; only POST /assistant/actions/:id/confirm
// (a plain, non-LLM code path) actually calls the underlying tool.

model PendingAssistantAction {
  id       String @id @default(uuid())
  tool     String
  argsJson Json

  requestedByUserId String
  status            PendingActionStatus @default(PENDING)
  createdAt         DateTime            @default(now())
  expiresAt         DateTime

  confirmedByUserId String?
  confirmedAt       DateTime?

  requestedBy User  @relation("PendingActionRequestedBy", fields: [requestedByUserId], references: [id])
  confirmedBy User? @relation("PendingActionConfirmedBy", fields: [confirmedByUserId], references: [id])

  @@index([status, expiresAt])
}

// ─── Automated AI Interview & Evaluation Engine ──────────────
// Replaces the old human-scheduled Interview/JobInterviewer/InterviewFeedback
// trio: FR-INT-02 runs a synchronous, AI-conducted session with no human
// interviewer in the loop.

model AIInterviewSession {
  id            String    @id @default(uuid())
  applicationId String    @unique
  status        IntStatus @default(PENDING)

  windowExpiresAt DateTime
  startedAt       DateTime?
  completedAt     DateTime?

  // Aggregate score derived from the skill matrix below.
  overallScore Decimal? @db.Decimal(5, 2)

  application Application           @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  questions   AIInterviewQuestion[]
  skillGrades CandidateSkillGrade[]
}

model AIInterviewQuestion {
  id                String    @id @default(uuid())
  sessionId         String
  sequenceOrder     Int
  questionText      String    @db.Text
  questionAudioUrl  String?
  answerText        String?   @db.Text
  candidateAudioUrl String?
  expectedCore      String    @db.Text
  askedAt           DateTime?
  answeredAt        DateTime?

  // Which skill this question is probing, and whether it's a fresh topic or
  // a targeted follow-up on the previous question — lets the orchestrator
  // track "distinct skills covered" vs "follow-ups used" across turns
  // (each turn is a separate HTTP request/response, so this can't just be
  // held in memory) and lets grading roll follow-up answers into the same
  // CandidateSkillGrade as their parent question.
  targetSkillId String?
  isFollowUp    Boolean @default(false)

  session     AIInterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  targetSkill Skill?             @relation(fields: [targetSkillId], references: [id])

  @@index([sessionId, sequenceOrder])
}

// FR-INT-03: per-skill proficiency score plus a mandatory textual
// justification, replacing the old fixed comm/tech/problem-solving columns.

model CandidateSkillGrade {
  id               String @id @default(uuid())
  sessionId        String
  skillId          String
  proficiencyScore Int
  justification    String @db.Text

  session AIInterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  skill   Skill              @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([sessionId, skillId])
}

// ─── Automated Communications ────────────────────────────────
// Audit trail for every system/HR-triggered email: screening rejection,
// interview acknowledgment (FR-INT-04), and the three HR action-button
// variants plus smart-closure bulk rejections (FR-HR-02/03).

model EmailLog {
  id                String    @id @default(uuid())
  applicationId     String
  type              EmailType
  sentAt            DateTime  @default(now())
  triggeredByUserId String?

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  triggeredBy User?       @relation("EmailTriggeredBy", fields: [triggeredByUserId], references: [id])

  @@index([applicationId])
}

// ─── Enums ──────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  HR_ADMIN
  HIRING_MANAGER
}

enum DocumentStatus {
  PROCESSING
  ACTIVE
  INACTIVE
  FAILED
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum AppStatus {
  APPLIED
  SCREENING
  SCREENING_REJECTED
  INTERVIEW_PENDING
  INTERVIEW_EXPIRED
  IN_REVIEW
  SELECTED
  NEXT_ROUND
  REJECTED
  HIRED
  WITHDRAWN
}

enum IntStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  EXPIRED
  CANCELLED
}

enum EmailType {
  SCREENING_REJECTION
  INTERVIEW_ACKNOWLEDGEMENT
  SELECTION
  NEXT_ROUND
  REJECTION
  BULK_REJECTION
}

enum WorkModel {
  REMOTE
  HYBRID
  ONSITE
}

enum CandidateSource {
  SELF_APPLIED
  HR_SOURCED
}

enum CvProcessingStatus {
  PROCESSING
  READY
  FAILED
}

enum MatchRecommendation {
  STRONG_MATCH
  POTENTIAL_MATCH
  NEEDS_REVIEW
  INSUFFICIENT_EVIDENCE
}

enum MatchConfidence {
  LOW
  MEDIUM
  HIGH
}

enum PendingActionStatus {
  PENDING
  CONFIRMED
  EXPIRED
  CANCELLED
}

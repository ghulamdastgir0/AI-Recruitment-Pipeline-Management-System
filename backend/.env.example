# Origin(s) allowed to call this API from a browser (the Next.js frontend).
# '*' is fine for local dev/testing; set explicitly for any deployed environment.
CORS_ORIGIN="*"
# Base URL of the candidate-facing frontend, used to build links (e.g. the
# interview page) embedded in outbound emails.
PUBLIC_APP_URL="http://localhost:3001"

DATABASE_URL="postgresql://postgres:postgres@localhost:5433/rms_db?schema=public"
GROQ_API_KEY="your-groq-api-key"
GROQ_API_URL="https://api.groq.com/openai/v1/chat/completions"
# llama-3.3-70b-versatile (the default chat model above) was found to
# confabulate fictional resumes for CV extraction instead of grounding on the
# actual CV text — gpt-oss-20b was verified reliable for this specific task.
GROQ_CV_PARSER_MODEL="openai/gpt-oss-20b"

# pgvector RAG embeddings run locally via @huggingface/transformers (Xenova/all-MiniLM-L6-v2, 384-dim) — no API key needed.

# Where uploaded policy PDFs are permanently stored on disk. Relative paths
# resolve from the backend/ working directory.
DOCUMENT_STORAGE_DIR="./storage/documents"

# Where uploaded candidate CVs are permanently stored on disk.
CV_STORAGE_DIR="./storage/cvs"

# JWT auth.
JWT_SECRET="generate-a-long-random-value"
JWT_EXPIRES_IN="8h"

# Used once by `npm run db:seed` to bootstrap the first ADMIN login.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me"

# Brevo (Sendinblue) transactional email API — https://api.brevo.com/v3/smtp/email.
SMTP_API="your-brevo-api-key"
# Must be a verified sender in the Brevo account that owns SMTP_API above.
BREVO_SENDER_EMAIL="notifications@example.com"
BREVO_SENDER_NAME="AI Recruitment Pipeline"

# Groq speech-to-text (candidate interview answers) and text-to-speech
# (interview questions read aloud). Same GROQ_API_KEY as chat completions.
GROQ_STT_API_URL="https://api.groq.com/openai/v1/audio/transcriptions"
GROQ_STT_MODEL="whisper-large-v3-turbo"
GROQ_TTS_API_URL="https://api.groq.com/openai/v1/audio/speech"
GROQ_TTS_MODEL="canopylabs/orpheus-v1-english"
GROQ_TTS_VOICE="troy"

# Where generated interview audio (TTS questions + candidate answer
# recordings) is permanently stored on disk.
INTERVIEW_AUDIO_STORAGE_DIR="./storage/interview-audio"
